# Server port (default: 3001)
PORT=3001
# SQLite database path (default: ./data/graphwar.db)
DB_PATH=./data/graphwar.db
# Extra comma-separated browser origins allowed by Socket.IO (optional)
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Optional client override. Leave unset for same-origin or the Vite proxy.
# VITE_SERVER_URL=http://localhost:3001
